{
  "name": "@kairos/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Measurement harness. Produces the detection-latency versus false-alarm curve and the scorecard.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "detect-curve": "node dist/main.js",
    "detect-curve:quick": "node dist/main.js --quick",
    "spend-bound": "node dist/spend-main.js",
    "spend-bound:quick": "node dist/spend-main.js --quick",
    "prevent": "node dist/prevent-main.js",
    "prevent:quick": "node dist/prevent-main.js --quick"
  },
  "dependencies": {
    "@kairos/detect": "workspace:*",
    "@kairos/domain": "workspace:*",
    "@kairos/ledger": "workspace:*",
    "@kairos/policy": "workspace:*",
    "@kairos/razorpay": "workspace:*",
    "@kairos/simulator": "workspace:*",
    "@kairos/terminus": "workspace:*",
    "throttlekit": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
