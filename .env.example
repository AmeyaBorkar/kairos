# Copy to .env and fill in. Never commit .env.
# Every credential here is TEST MODE ONLY. Live keys must not exist in this project.

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Used to verify the HMAC-SHA256 signature on inbound webhooks, over the raw body.
RAZORPAY_WEBHOOK_SECRET=

# --- Storage ---
DATABASE_URL=postgres://kairos:kairos@localhost:5432/kairos
# Optional. Terminus runs on Postgres alone; Redis only shortens the hot path.
REDIS_URL=

# --- Reasoner (classification, copy generation, ledger explanation) ---
# Needed for exactly one job: regenerating the copy library with
#   pnpm --filter @kairos/scribe run compose
# Tests, lint, typecheck and the whole benchmark run with this unset — the
# adapter's tests replay a committed cassette and never open a socket.
# Free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Every default and the measurement behind it are in
# adapters/reasoner-gemini/src/config.ts. Note that gemini-2.5-flash is retired:
# a new key gets a 404 pointing at gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_RPM=10
# GEMINI_RPD=200
# GEMINI_MAX_ATTEMPTS=4

# --- Messaging ---
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_KEY=

# --- Terminus ---
# Signing key for mandates. Generate with: openssl rand -hex 32
KAIROS_MANDATE_SECRET=
KAIROS_MERCHANT_ID=
KAIROS_BUDGET_PAISE=100000
# Keyed hash for pseudonymising identifiers in the ledger. Generate the same way.
LEDGER_PII_HASH_KEY=

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
