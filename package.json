{
  "name": "kairos",
  "version": "0.0.0",
  "private": true,
  "description": "Payment-health defence for Indian merchants. Detect a rail degrading, steer traffic off it under provable bounds, recover the casualties.",
  "license": "MIT",
  "author": "Ameya Borkar",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench:detect": "pnpm build && pnpm --filter @kairos/bench run detect-curve",
    "bench:detect:quick": "pnpm build && pnpm --filter @kairos/bench run detect-curve:quick",
    "bench:spend": "pnpm build && pnpm --filter @kairos/bench run spend-bound",
    "bench:spend:quick": "pnpm build && pnpm --filter @kairos/bench run spend-bound:quick",
    "bench:prevent": "pnpm build && pnpm --filter @kairos/bench run prevent",
    "bench:prevent:quick": "pnpm build && pnpm --filter @kairos/bench run prevent:quick",
    "bench:recover": "pnpm build && pnpm --filter @kairos/bench run recover",
    "bench:recover:quick": "pnpm build && pnpm --filter @kairos/bench run recover:quick",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:deps": "node scripts/check-deps.mjs",
    "check": "pnpm lint && pnpm check:deps && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
