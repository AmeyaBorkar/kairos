{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Browser only. No node types here on purpose: the source that ships to a tab must not be able
    // to reach for `node:fs` and have it typecheck.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {}
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
