# Copy to .env and fill in. Never commit .env.
# Every credential here is TEST MODE ONLY. Live keys must not exist in this project.

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Used to verify the HMAC-SHA256 signature on inbound webhooks, over the raw body.
RAZORPAY_WEBHOOK_SECRET=

# --- Storage ---
DATABASE_URL=postgres://kairos:kairos@localhost:5432/kairos
# Optional. Terminus runs on Postgres alone; Redis only shortens the hot path.
REDIS_URL=

# --- Reasoner (diagnosis and message composition) ---
ANTHROPIC_API_KEY=
KAIROS_REASONER_MODEL=claude-sonnet-5

# --- Messaging ---
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_KEY=

# --- Terminus ---
# Signing key for mandates. Generate with: openssl rand -hex 32
TERMINUS_MANDATE_SECRET=
# Keyed hash for pseudonymising identifiers in the ledger. Generate the same way.
LEDGER_PII_HASH_KEY=

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
